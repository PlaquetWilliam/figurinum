# Modèle de configuration — copier vers .env puis remplir avec vos valeurs.
# Ce fichier est versionné : il ne doit contenir AUCUNE valeur réelle.
#
#   cp .env.example .env          (Windows : copy .env.example .env)

# --- Obligatoire ---------------------------------------------------------

# URI de connexion MongoDB (local ou Atlas).
# Exemple local : mongodb://127.0.0.1:27017/figurinum
MONGODB_URI=

# Clé de signature des JWT de session (HS256). Obligatoire, 32 caractères
# minimum, aucune valeur par défaut n'est prévue par l'application.
# Générer une valeur aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# URL publique de l'application (utilisée pour les retours Stripe et les
# images absolues). En local : http://localhost:3000
NEXT_PUBLIC_APP_URL=

# --- Optionnel : Stripe --------------------------------------------------
# Laisser vide pour conserver le paiement de démonstration (sans Stripe).

# Clé secrète Stripe (sk_test_... en environnement de test).
STRIPE_SECRET_KEY=

# Secret de signature du webhook (whsec_...), fourni par `stripe listen`
# ou par le dashboard Stripe.
STRIPE_WEBHOOK_SECRET=

# Clé publiable Stripe (pk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
